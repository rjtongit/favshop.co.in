DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/favshop_fastapi
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# Fastrr / Shiprocket Smart One-Click Checkout
# Get these from Shiprocket Checkout -> Settings -> Manage Channel -> Custom -> Smart One-Click Checkout -> API Key / Developer Hub.
SHIPROCKET_CHECKOUT_API_KEY=
SHIPROCKET_CHECKOUT_API_SECRET=
SHIPROCKET_CHECKOUT_BASE_URL=https://checkout-api.shiprocket.com
SHIPROCKET_CHECKOUT_TIMEOUT=20

# Change this to your public website URL before production.
FASTRR_REDIRECT_URL=http://localhost:4200/checkout/success
# Replace this with a real product image URL when your catalog has product images.
FASTRR_DEFAULT_PRODUCT_IMAGE_URL=https://placehold.co/600x600/png?text=FavShop
PUBLIC_API_URL=http://localhost:8000

# Legacy Razorpay settings (not used by the Fastrr checkout flow)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
